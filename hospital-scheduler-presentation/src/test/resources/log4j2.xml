<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="ConsoleAppender" target="SYSTEM_OUT">
      <PatternLayout pattern="%d [%t] %-5level %logger{36} - %msg%n%throwable"/>
    </Console>
    <File name="DoctorFileAppender" fileName="logs/DoctorPresenter.log" append="true">
      <PatternLayout pattern="%d [%t] %-5level %logger{36} - %msg%n%throwable"/>
    </File>
    
    <File name="DepartmentFileAppender" fileName="logs/DepartmentPresenter.log" append="true">
      <PatternLayout pattern="%d [%t] %-5level %logger{36} - %msg%n%throwable"/>
    </File>
    
    <File name="ShiftFileAppender" fileName="logs/ShiftPresenter.log" append="true">
      <PatternLayout pattern="%d [%t] %-5level %logger{36} - %msg%n%throwable"/>
    </File>
  </Appenders>
  <Loggers>
    <Logger name="org.duckdns.whocaresleft.presenter.DoctorPresenter" level="DEBUG" additivity="false">
      <AppenderRef ref="DoctorFileAppender"/>
    </Logger>
    
    <Logger name="org.duckdns.whocaresleft.presenter.DepartmentPresenter" level="DEBUG" additivity="false">
      <AppenderRef ref="DepartmentFileAppender"/>
    </Logger>
    
    <Logger name="org.duckdns.whocaresleft.presenter.ShiftPresenter" level="DEBUG" additivity="false">
      <AppenderRef ref="ShiftFileAppender"/>
    </Logger>
    <Root level="WARN">
      <AppenderRef ref="ConsoleAppender"/>
    </Root>
  </Loggers>
</Configuration>