<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="maria_doctor_repository_it" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>org.duckdns.whocaresleft.repository.mariadb.entity.DoctorEntity</class>
        <class>org.duckdns.whocaresleft.repository.mariadb.entity.DepartmentEntity</class>
        <class>org.duckdns.whocaresleft.repository.mariadb.entity.ShiftEntity</class>
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="for_learning_tests" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>org.duckdns.whocaresleft.learning.hibernate.LearningEntity</class>
        <class>org.duckdns.whocaresleft.learning.hibernate.LearningEntityBirthday</class>
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>